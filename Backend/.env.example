PORT=5000
CORS_ORIGIN=http://localhost:5173
# Keep 0 unless requests arrive through a trusted reverse proxy. If they do,
# set this to the exact number of trusted proxy hops; do not use "true".
TRUST_PROXY_HOPS=0

# Use a MongoDB connection URI without a database name; DB_NAME is appended by the app.
DB_URL=mongodb://127.0.0.1:27017
DB_NAME=Neoplay+

# Replace these examples with private random secrets of at least 32 characters.
ACCESS_TOKEN_SECRET=replace-this-with-a-private-random-secret-at-least-32-chars
REFRESH_TOKEN_SECRET=replace-this-with-another-private-random-secret-at-least-32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Admin identifiers are encrypted at rest; use private, persistent keys.
# The encryption key accepts 64-char hex or 43-char base64url encoding.
# Generate hex with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_DATA_ENCRYPTION_KEY=replace-with-a-private-64-character-hex-key
ADMIN_LOOKUP_HMAC_KEY=replace-this-with-a-private-random-secret-at-least-32

REDIS_URL=redis://127.0.0.1:6379
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

MEDIA_MAX_UPLOAD_MB=100
MEDIA_UPLOAD_CHUNK_MB=5
MEDIA_MAX_VIDEO_SECONDS=3600
MEDIA_UPLOAD_MAX_AGE_HOURS=2
MEDIA_TEMP_DIR=./tmp/media
MEDIA_PROCESS_TIMEOUT_SECONDS=900
MEDIA_CLOUDINARY_UPLOAD_TIMEOUT_SECONDS=600