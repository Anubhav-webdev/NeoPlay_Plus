PORT=5000
CORS_ORIGIN=http://localhost:5173

# Use a MongoDB connection URI without a database name; DB_NAME is appended by the app.
DB_URL=mongodb://127.0.0.1:27017
DB_NAME=Neoplay+

# Replace these examples with private random secrets of at least 32 characters.
ACCESS_TOKEN_SECRET=replace-this-with-a-private-random-secret-at-least-32-chars
REFRESH_TOKEN_SECRET=replace-this-with-another-private-random-secret-at-least-32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

REDIS_URL=redis://127.0.0.1:6379
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

MEDIA_MAX_UPLOAD_MB=100
MEDIA_MAX_VIDEO_SECONDS=3600
MEDIA_TEMP_DIR=./tmp/media